# Dockerfile.server for Fides backend service
# Multi-stage build for Go backend

# Stage 0: Build the source-owned Next.js portal. It is built twice: once for the
# default root ("/") and once under /next (kept for compatibility / bookmarks).
FROM node:22-alpine AS portal
WORKDIR /portal
COPY portal/package.json portal/package-lock.json ./
# --include=dev so build tools (tailwind/postcss) install even if NODE_ENV=production.
RUN npm ci --include=dev
COPY portal/ ./
RUN npm run build && cp -r out /portal-root
RUN PORTAL_BASE_PATH=/next npm run build && cp -r out /portal-next

# Stage 1: Build the Go binary
FROM golang:alpine AS builder


WORKDIR /app

# Install git/certs
RUN apk add --no-cache git ca-certificates

# Copy dependency files and download
# (Uncomment when actual go.mod exists)
# COPY go.mod go.sum ./
# RUN go mod download

# Copy source code
COPY . .

# CUTOVER: the new source-owned portal becomes the default at /. Preserve the
# Go-served markdown docs (used by the Help page) and llms.txt files, then
# replace the old compiled SPA with the new portal. The /next path keeps serving
# the same portal for compatibility. To roll back, git-revert this and redeploy.
RUN mkdir -p /keep && (cp web/*.md /keep/ 2>/dev/null || true) && (cp web/llms*.txt /keep/ 2>/dev/null || true)
RUN rm -rf web
COPY --from=portal /portal-root/. ./web/
COPY --from=portal /portal-next/. ./web/next/
RUN (cp /keep/*.md web/ 2>/dev/null || true) && (cp /keep/llms*.txt web/ 2>/dev/null || true)
# The Help-page docs reference screenshots as ../docs/images/... — right on GitHub
# (web/README.md -> repo docs/), and in the portal it resolves to /docs/images/...
# too: the Help page renders at /help, one segment deep, and a browser clamps the
# leading ".." at the root. Staging the images under web/docs/ makes one link work
# in both places, so the docs/ and web/ copies stay byte-identical. Without this
# every screenshot in the portal's own docs is a broken image.
RUN mkdir -p web/docs && cp -r docs/images web/docs/images

# Build static binaries: the server and the stdio MCP sensor (real MCP server
# used by environment compliance checks).
# -trimpath so the binary does not embed the builder's absolute paths, which is
# what makes the build reproducible -- and what lets anyone check that this
# image is the source it claims to be. release.yml already builds this way; the
# container did not, so the two shipped different guarantees.
#
# FIDES_VERSION defaults to "dev" for a plain `docker build`; CI passes the
# release tag with --build-arg so the shipped binaries' version log/output
# matches the image tag instead of falling back to the git revision baked in
# at image-build time.
ARG FIDES_VERSION=dev

# ./cmd/server, not cmd/server/main.go: naming the file compiles only that file,
# so a second file added to the package would be silently left out of the image.
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-w -s -X fides/pkg/version.Version=${FIDES_VERSION}" -o fides-server ./cmd/server
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-w -s -X fides/pkg/version.Version=${FIDES_VERSION}" -o fides-mcp-sensor ./cmd/mcp-sensor
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-w -s -X fides/pkg/version.Version=${FIDES_VERSION}" -o fides-mcp ./cmd/mcp

# Stage 2: Minimal runtime image
#
# alpine 3.23, NOT 3.18. 3.18 went EOL, so no further security updates ship for
# it: an OS-layer CVE there would never get a FixedVersion, and the Trivy gates
# run with --ignore-unfixed, so they would silently drop it. A green scan on an
# EOL base means "nothing fixable", not "nothing wrong" (#399).
FROM alpine:3.23

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

# Copy binary and static web assets from builder
COPY --from=builder /app/fides-server /app/fides-server
COPY --from=builder /app/fides-mcp-sensor /usr/local/bin/fides-mcp-sensor
COPY --from=builder /app/fides-mcp /usr/local/bin/fides-mcp
COPY --from=builder /app/web /app/web


# Expose port
EXPOSE 8080

# Run server
ENTRYPOINT ["/app/fides-server"]
