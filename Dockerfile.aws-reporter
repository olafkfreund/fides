# Fides AWS reporter image: the `fides` CLI + the AWS CLI, for the
# terraform-aws-fides-reporter scheduled Fargate task. Runs e.g.
#   fides snapshot ecs --env <id> --cluster <name>
# which shells out to the AWS CLI (aws ecs list-tasks/describe-tasks,
# aws lambda list-functions) and reports running artifacts to Fides.
FROM golang:alpine AS builder
WORKDIR /app
RUN apk add --no-cache git ca-certificates
COPY . .
# CGO-free static binary runs on the glibc-based aws-cli base below.
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o fides ./cmd/cli

FROM amazon/aws-cli:2.17.0
COPY --from=builder /app/fides /usr/local/bin/fides
ENTRYPOINT ["fides"]
