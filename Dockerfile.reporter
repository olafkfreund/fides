# Fides Kubernetes reporter image: the `fides` CLI + kubectl, for the
# k8s-reporter CronJob (charts/fides-k8s-reporter). The CronJob runs
#   fides snapshot k8s --env <environment-id> [--namespace <ns>]
# which shells out to kubectl to read running pods and reports the running
# image digests to the Fides server (POST /api/v1/snapshots). Fides diffs
# successive snapshots into drift / shadow-change reports.
FROM golang:alpine AS builder
WORKDIR /app
RUN apk add --no-cache git ca-certificates
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-w -s" -o fides ./cmd/cli

# alpine 3.23, NOT 3.18. 3.18 went EOL, so no further security updates ship for
# it: an OS-layer CVE there would never get a FixedVersion, and the Trivy gates
# run with --ignore-unfixed, so they would silently drop it. A green scan on an
# EOL base means "nothing fixable", not "nothing wrong" (#399).
FROM alpine:3.23
RUN apk add --no-cache ca-certificates
# NO kubectl. It used to be baked in here for exactly one call
# (`kubectl get pods -o json`); the CLI now reads the API server directly with
# net/http and the mounted ServiceAccount token (cmd/cli/k8s.go), so a ~50MB
# third-party binary is gone from the image (#398).
#
# That binary carried 24 fixable HIGH/CRITICAL CVEs in ITS OWN vendored deps
# (Go stdlib, x/net, x/oauth2, x/text, spdystream) which we could not patch
# without rebuilding kubectl, and no released version was clean -- measured
# 2026-08-12: v1.31.14 -> 24, v1.32.13 -> 21, v1.33.13 -> 7, v1.34.10 /
# v1.35.7 / v1.36.3 -> 6. It was excepted by path from both Trivy gates. That
# exception is now DELETED, not widened: the gates run at full strength with no
# skips on either image.
#
# client-go was the obvious alternative and was rejected: it pulls ~100 modules
# including its own golang.org/x/net, which relocates the CVE surface instead of
# removing it. Off-cluster (a laptop) the CLI still shells out to kubectl for
# its kubeconfig -- that path just is not shipped in this image.
COPY --from=builder /app/fides /usr/local/bin/fides
USER 65532:65532
ENTRYPOINT ["fides"]
